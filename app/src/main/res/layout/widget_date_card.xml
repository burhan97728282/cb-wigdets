<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextClock
            android:id="@+id/weekday"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FF55514A"
            android:textStyle="bold" />

        <View
            android:id="@+id/accent_bar"
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginVertical="2dp"
            android:background="#FFE08A1E" />

        <TextClock
            android:id="@+id/daynum"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:autoSizeMaxTextSize="110sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF1F1D19"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/month"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:format12Hour="MMMM yyyy"
            android:format24Hour="MMMM yyyy"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF55514A" />
    </LinearLayout>
</FrameLayout>
