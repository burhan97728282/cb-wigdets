<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CbWidgetsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CbWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CbWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= Home-screen widgets ================= -->

        <receiver
            android:name=".widgets.clock.DigitalClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_digital_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_digital_info" />
        </receiver>

        <receiver
            android:name=".widgets.clock.MinimalClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_minimal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_minimal_info" />
        </receiver>

        <receiver
            android:name=".widgets.clock.AnalogClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_analog_info" />
        </receiver>

        <receiver
            android:name=".widgets.clock.DateCardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_date_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_card_info" />
        </receiver>

        <receiver
            android:name=".widgets.battery.BatteryRingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_ring_info" />
        </receiver>

        <receiver
            android:name=".widgets.battery.BatteryBarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_bar_info" />
        </receiver>

    </application>
</manifest>
